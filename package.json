    "build": "nx run-many --target=build --all",
    "coverage:merge": "node tools/merge-coverage.mjs coverage/combined/coverage-final.json coverage/backend/coverage-final.json coverage/backend-e2e/coverage-final.json",
    "fixtures:fetch": "node tools/fetch-fixtures.mjs",
    "format": "prettier -w .",
    "format:check": "prettier --check .",
    "i18n:find": "node tools/i18n-check.mjs",
    "knip": "knip",
    "lint": "nx run-many --target=lint",
    "start": "nx run-many --target=serve --all",
    "start:be": "NX_DAEMON=false nx run backend:serve",
    "start:fe": "NX_DAEMON=false nx run frontend:serve",
    "test": "nx run-many --target=test --all --exclude=backend-e2e",
    "test:coverage": "nx run-many --target=test-ci --all",
    "test:coverage:combined": "pnpm test:coverage && pnpm coverage:merge",
    "test:e2e": "nx run backend-e2e:test",
    "test:full": "nx run backend:test:full",
    "test:watch": "nx run-many --target=test --all --watch --exclude=backend-e2e",
    "typecheck": "nx run-many --target=typecheck --all",
    "typeorm": "typeorm-ts-node-esm"
  },
