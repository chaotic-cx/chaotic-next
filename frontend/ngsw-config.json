{
  "$schema": "../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/favicon.ico", "/site.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/**", "!/**/*.map", "!/memorials/**"]
      }
    }
  ],
  "navigationUrls": ["/**", "!/backend/**", "!/**/__*", "!/**/sse"]
}
