{
  "$schema": "../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/favicon.ico", "/site.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/**", "!/**/*.map", "!/memorials/**"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "garuda-api",
      "urls": ["https://builds.garudalinux.org/**"],
      "cacheConfig": {
        "maxSize": 0,
        "maxAge": "0s",
        "timeout": "0s",
        "strategy": "freshness"
      }
    }
  ],
  "navigationUrls": ["/**", "!/backend/**", "!/**/__*", "!/**/sse", "!/aizawa/**", "!/memorials/**"]
}
