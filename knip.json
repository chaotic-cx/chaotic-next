{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "backend/src/data/migration-cli.ts",
    "backend/src/main.ts",
    "backend/src/scripts/*.ts",
    "backend-e2e/src/test/*.ts",
    "frontend/src/environments/environment.prod.ts",
    "frontend/src/main.ts",
    "shared-lib/src/index.ts"
  ],
  "project": ["backend/src/**/*.ts", "frontend/src/**/*.{ts,css}", "shared-lib/src/**/*.ts"],
  "ignore": [
    "backend/src/test/silence-nest-logger.ts",
    "frontend/src/**/*.css",
    "frontend/src/test-setup.ts",
    "backend/src/migrations/**/*.ts",
    "backend/src/builder/builder.entity.ts",
    "backend/src/portable-builder/portable-builder.dto.ts"
  ],
  "ignoreUnresolved": ["src/test/silence-nest-logger.ts", "src/test-setup.ts"],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "@angular-eslint/*",
    "@catppuccin/*",
    "@eslint/*",
    "@fontsource-variable/*",
    "@nx/*",
    "@openng/icons",
    "@openng/optimus-ui-tailwindcss",
    "@typescript-eslint/*",
    "angular-eslint",
    "eslint-plugin-*",
    "pino-pretty",
    "testcontainers",
    "typescript-eslint",
    "unplugin-swc"
  ]
}
